{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "type": {
      "const": "daybreak-decisions"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "type": {
            "enum": [
              "answer",
              "note",
              "skip",
              "retry_after_review",
              "prepare_cv",
              "request_revision",
              "reconsider"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 10000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "enum": [
              "user"
            ]
          },
          "targetResumeId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          },
          "targetResumeSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "jobId",
          "type",
          "content",
          "createdAt",
          "actor"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "id",
    "createdAt",
    "baseRevision",
    "decisions"
  ],
  "additionalProperties": false
}
